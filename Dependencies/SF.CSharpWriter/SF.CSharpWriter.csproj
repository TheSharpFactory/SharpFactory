<Project Sdk="Microsoft.NET.Sdk">

  <!-- writes C# source files from code, one file at a time (CSharpFile) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AssemblyName>SF.CSharpWriter</AssemblyName>
    <RootNamespace>SF.CodeGeneration</RootNamespace>
  </PropertyGroup>

</Project>
