<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SF.App.App"
             x:ClassModifier="internal"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#56AEFF" RegionColor="#1C1F24" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://TheSharpFactory/Styles/AppStyles.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="RailBackground" Color="#16191D" />
          <!-- the part of a tree title that matches the search -->
          <SolidColorBrush x:Key="SearchMatchBackground" Color="#4A3D12" />
          <SolidColorBrush x:Key="SearchMatchText" Color="#FFD479" />
          <!-- the code file tabs fade out at an edge that has more tabs -->
          <LinearGradientBrush x:Key="TabsFadeRight" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#0016191D" />
            <GradientStop Offset="0.6" Color="#FF16191D" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="TabsFadeLeft" StartPoint="100%,0%" EndPoint="0%,0%">
            <GradientStop Offset="0" Color="#0016191D" />
            <GradientStop Offset="0.6" Color="#FF16191D" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="CardBackground" Color="#24282E" />
          <SolidColorBrush x:Key="CardBorder" Color="#353B43" />
          <SolidColorBrush x:Key="SubtleText" Color="#A0A8B2" />
          <SolidColorBrush x:Key="OverlayBackground" Color="#99000000" />
          <SolidColorBrush x:Key="InsertedBackground" Color="#1E3A26" />
          <SolidColorBrush x:Key="DeletedBackground" Color="#45201F" />
          <SolidColorBrush x:Key="ErrorText" Color="#FF8A80" />
          <SolidColorBrush x:Key="SuccessText" Color="#81C784" />
          <SolidColorBrush x:Key="BadgeBackground" Color="#23384F" />
          <SolidColorBrush x:Key="DangerBackground" Color="#D64545" />
          <SolidColorBrush x:Key="DangerBackgroundPointerOver" Color="#E05858" />
          <SolidColorBrush x:Key="DangerBackgroundPressed" Color="#C23B3B" />
          <SolidColorBrush x:Key="DangerBorder" Color="#7A3A38" />
          <SolidColorBrush x:Key="FieldErrorBackground" Color="#2E2022" />
          <!-- primary buttons: a deeper blue than the accent, so white text reads well -->
          <SolidColorBrush x:Key="PrimaryBackground" Color="#2F7FD1" />
          <SolidColorBrush x:Key="PrimaryBackgroundPointerOver" Color="#3A8BDD" />
          <SolidColorBrush x:Key="PrimaryBackgroundPressed" Color="#2A72BC" />
          <SolidColorBrush x:Key="WarningText" Color="#F2B84B" />
          <SolidColorBrush x:Key="WarningBackground" Color="#2F2919" />
          <SolidColorBrush x:Key="WarningBorder" Color="#5A4A22" />
          <SolidColorBrush x:Key="SuccessBorder" Color="#2F5A3A" />
          <SolidColorBrush x:Key="CodeBackground" Color="#1E2226" />
          <SolidColorBrush x:Key="LogText" Color="#AEB6BF" />
          <SolidColorBrush x:Key="PreviewTint" Color="#1F2B3A" />
          <SolidColorBrush x:Key="SuccessTint" Color="#1D2D23" />
          <SolidColorBrush x:Key="ErrorTint" Color="#33201F" />

          <SolidColorBrush x:Key="ButtonBackground" Color="#2A2F36" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#323840" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3A4049" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#24282E" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#464D57" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#5B636E" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#5B636E" />
          <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#333840" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#E6E9ED" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F2F4F7" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E6E9ED" />
          <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6A727C" />

          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#464D57" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#5B636E" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#464D57" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#5B636E" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>

