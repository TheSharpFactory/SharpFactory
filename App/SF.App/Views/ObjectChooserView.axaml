<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SF.App.ViewModels"
             xmlns:views="using:SF.App.Views"
             x:Class="SF.App.Views.ObjectChooserView"
             x:ClassModifier="internal"
             x:DataType="vm:ObjectChooserViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <TextBox Name="ChooserSearch" Text="{Binding SearchText}" PlaceholderText="Search objects…">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="10,0,0,0" Opacity="0.6" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
        <Button Name="SelectAllButton" Command="{Binding SelectAllCommand}" Content="Select all" />
        <Button Name="SelectNoneButton" Command="{Binding SelectNoneCommand}" Content="None" />
      </StackPanel>
    </Grid>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
      <TextBlock Name="ChooserCount" Classes="subtle" Text="{Binding CountText}" />
      <TextBlock Grid.Column="1" Name="ChooserChanges" Text="{Binding ChangeText}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="16,0,0,0"
                 IsVisible="{Binding HasChangeText}" />
    </Grid>
    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8">
      <TreeView Name="ChooserTree" Classes="dense" ItemsSource="{Binding Roots}">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:ChooserNode">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="vm:ChooserNode" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <CheckBox IsChecked="{Binding IsChecked}" IsThreeState="False" Padding="4,0" MinHeight="0" Height="24" VerticalContentAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Classes="nodeIcon" Data="{Binding IconKey, Converter={x:Static views:IconConverter.Instance}}" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </CheckBox>
              <TextBlock Classes="subtle" FontSize="12" Text="{Binding Detail}" VerticalAlignment="Center" />
              <Border Classes="pill" VerticalAlignment="Center"
                      Classes.added="{Binding Mark, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter=new}"
                      Classes.deleted="{Binding Mark, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter=removed}"
                      IsVisible="{Binding Mark, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding Mark}" />
              </Border>
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Border>
  </DockPanel>
</UserControl>
