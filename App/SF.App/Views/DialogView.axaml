<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SF.App.ViewModels"
             x:Class="SF.App.Views.DialogView"
             x:ClassModifier="internal"
             x:DataType="vm:DialogViewModel">
  <Border Classes="card" MinWidth="420" MaxWidth="560" BoxShadow="0 8 32 0 #40000000">
    <StackPanel Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <!-- red for an error, amber for a warning -->
        <PathIcon Name="DialogErrorSign" Data="{StaticResource IconWarning}" Width="22" Height="22" Foreground="{DynamicResource ErrorText}" IsVisible="{Binding HasErrorSign}" />
        <PathIcon Name="DialogWarningSign" Data="{StaticResource IconWarning}" Width="22" Height="22" Foreground="{DynamicResource WarningText}" IsVisible="{Binding HasWarningSign}" />
        <TextBlock Classes="sectionTitle" FontSize="18" Margin="0" Text="{Binding Title}" VerticalAlignment="Center" />
      </StackPanel>
      <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DialogButton">
            <Button Content="{Binding Text}" Classes.accent="{Binding IsPrimary}" Classes.danger="{Binding IsDanger}" MinWidth="90" HorizontalContentAlignment="Center"
                    Command="{Binding $parent[UserControl].((vm:DialogViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
