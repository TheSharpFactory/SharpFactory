<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SF.App.ViewModels"
             x:Class="SF.App.Views.StepIndicator"
             x:ClassModifier="internal"
             x:DataType="vm:ModelWizardViewModel">
  <ItemsControl ItemsSource="{Binding Steps}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="22" /></ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:StepItem">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Classes="step" Classes.current="{Binding IsCurrent}" Classes.done="{Binding IsDone}">
            <Panel>
              <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding !IsDone}" />
              <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Foreground="White" IsVisible="{Binding IsDone}" />
            </Panel>
          </Border>
          <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
