<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SF.App.ViewModels"
             x:Class="SF.App.Views.AboutPage"
             x:ClassModifier="internal"
             x:DataType="vm:AboutPageViewModel">
  <StackPanel Margin="28,22" Spacing="16">
    <TextBlock Classes="pageTitle" Text="About" />
    <Border Classes="card" HorizontalAlignment="Left" Width="680" Padding="0">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,24,*" Margin="24">
          <Image Source="/Assets/LogoWithText.png" Width="96" Height="126" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
            <TextBlock Name="AboutProductName" FontSize="22" FontWeight="SemiBold" Text="{Binding ProductName}" />
            <TextBlock Name="AboutVersion" Classes="subtle" Text="{Binding ProductVersion}" />
            <TextBlock Text="{Binding ProductEdition}" />
            <StackPanel Orientation="Horizontal" Spacing="28" Margin="0,4,0,0">
              <HyperlinkButton Name="AboutWebsiteLink" Classes="plainLink" NavigateUri="{Binding Website}" Padding="0,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="thesharpfactory.com" />
                  <PathIcon Data="{StaticResource IconLink}" Width="12" Height="12" />
                </StackPanel>
              </HyperlinkButton>
              <HyperlinkButton Name="AboutReleasesLink" Classes="plainLink" NavigateUri="{Binding Releases}" Padding="0,4" ToolTip.Tip="Release notes and downloads on GitHub">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Releases" />
                  <PathIcon Data="{StaticResource IconLink}" Width="12" Height="12" />
                </StackPanel>
              </HyperlinkButton>
              <HyperlinkButton Name="AboutIssuesLink" Classes="plainLink" NavigateUri="{Binding Issues}" Padding="0,4" ToolTip.Tip="Report a problem or ask for a feature on GitHub">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Report an issue" />
                  <PathIcon Data="{StaticResource IconLink}" Width="12" Height="12" />
                </StackPanel>
              </HyperlinkButton>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="24,16">
          <StackPanel Spacing="10" DataContext="{Binding Updates}" x:DataType="vm:UpdatesViewModel">
            <TextBlock Classes="sectionTitle" Text="Updates" Margin="0" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Name="CheckForUpdatesButton" Content="Check for updates" Command="{Binding CheckNowCommand}" IsEnabled="{Binding IsIdle}" />
              <Button Name="UpdateNowButton" Classes="accent" Content="{Binding UpdateButtonText}" Command="{Binding UpdateNowCommand}" IsVisible="{Binding HasUpdate}" IsEnabled="{Binding IsIdle}" />
              <Button Name="CancelUpdateButton" Content="Cancel" Command="{Binding CancelUpdateCommand}" IsVisible="{Binding CanCancel}" ToolTip.Tip="Stop the download; the app stays as it is" />
            </StackPanel>
            <TextBlock Name="UpdateStatus" Text="{Binding StatusText}" TextWrapping="Wrap" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ProgressBar Name="UpdateProgress" Height="4" Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" IsIndeterminate="{Binding !IsDownloadPercentKnown}" IsVisible="{Binding IsInstalling}" />
            <CheckBox Name="CheckForUpdatesAutomatically" IsChecked="{Binding CheckAutomatically}" Content="Check for updates once a day" />
            <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Text="The check asks GitHub for the latest release and sends only the app's name and version. Nothing is downloaded until you choose Update." />
          </StackPanel>
        </Border>
        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="24,16">
          <StackPanel Spacing="12">
            <TextBlock Classes="sectionTitle" Text="Diagnostics" Margin="0" />
            <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto">
              <TextBlock Classes="subtle" Text="Error logs" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="mono" FontSize="12" Text="{Binding LogsFolder}" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" ToolTip.Tip="{Binding LogsFolder}" />
              <HyperlinkButton Grid.Column="2" Classes="plainLink" NavigateUri="{Binding LogsFolderUri}" Content="Open folder" Margin="12,0,0,0" />
              <TextBlock Grid.Row="1" Classes="subtle" Text="App settings" VerticalAlignment="Center" Margin="0,10,0,0" />
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" FontSize="12" Text="{Binding SettingsFile}" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" ToolTip.Tip="{Binding SettingsFile}" Margin="0,10,0,0" />
              <HyperlinkButton Grid.Row="1" Grid.Column="2" Classes="plainLink" NavigateUri="{Binding SettingsFolderUri}" Content="Open folder" Margin="12,10,0,0" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
