<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AssemblyName>TheSharpFactory</AssemblyName>
    <RootNamespace>SF.App</RootNamespace>
    <ApplicationIcon>Assets\SharpFactory.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- the public key updates are signed for (release.yml checks its signature against this same file) -->
    <EmbeddedResource Include="Packaging\update-signing-key.pem" LogicalName="update-signing-key.pem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\SF.Common\SF.Common.csproj" />
    <ProjectReference Include="..\..\Dependencies\SF.Engine\SF.Engine.csproj" />
    <ProjectReference Include="..\..\Dependencies\SF.Models\SF.Models.csproj" />
    <ProjectReference Include="..\..\Dependencies\SF.Utils\SF.Utils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SF.App.Tests" />
  </ItemGroup>

</Project>
